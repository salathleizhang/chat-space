# 复制为 chat/.env。凭证只保存在运行本机服务的设备上，不写入前端或 Cloudflare。
# 不要提交 chat/.env。

#CHAT_PORT=3901
# 云端容器用 CHAT_HOST=0.0.0.0；未设置 CHAT_PORT 时也支持平台的 PORT。
#CHAT_HOST=127.0.0.1
#CHATSPACE_LIBRARY_DIR=/absolute/path/to/ChatSpace

# 火山方舟：GLM 5.3 Flash / DeepSeek V4.1 Flash / Doubao-Seed-Evolving / Doubao-Seed-2.1-pro 对话，
# Seedream 图片，以及 Seed3D / Hyper3D / Hi3D 生成。
#VOLC_KEY=replace-with-your-key
# 常规火山方舟 API 默认使用 /api/v3；若你的对话模型使用其他接入点，请覆盖。
VOLC_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 自动选择默认使用 VOLC_GLM_MODEL；可单独覆盖默认模型。
#VOLC_LLM_MODEL=glm-5-3-flash-260828
# 四个选项分别映射到以下模型 ID；如控制台显示专属接入点 ID，可覆盖。
VOLC_GLM_MODEL=glm-5-3-flash-260828
VOLC_DEEPSEEK_MODEL=deepseek-v4-1-flash-260910
VOLC_DOUBAO_EVOLVING_MODEL=doubao-seed-evolving
VOLC_DOUBAO_PRO_MODEL=doubao-seed-2-1-pro-260915
# 若控制台显示专属模型 ID 或 ep-... 接入点，可覆盖官方示例值。
VOLC_HYPER3D_MODEL=hyper3d-gen2-260112
VOLC_HI3D_MODEL=hitem3d-2-0-251223

# Tripo3D 与 World Labs 的官方服务端 API。
#TRIPO_KEY=replace-with-your-key
# Tripo3D 图生 3D 的几何模型 ID（v3 必填），只作用于界面里的「Tripo 3.1」这一项。
# 可选 v3.1-20260211（默认，质量最好）、v3.0-20250812（稳定）、v2.5-20250123（更省额度）。
# 低多边形 P 系列（P1-20260311 / P2-20260801）在界面下拉里单独选择，不受这个变量影响。
# 贴图固定用最新的 v3.5-20260815（v2.5 几何仍配 v2.5 贴图）。
TRIPO_IMAGE_MODEL=v3.1-20260211
# 腾讯混元只用于 unwrap-uv；格式为 SecretId:SecretKey。
#HUNYUAN_KEY=replace-secret-id:replace-secret-key
#WORLDLABS_KEY=replace-with-your-key

# 允许访问服务的网页完整 origin（Vercel / Cloudflare Pages / 同源云端站点），多个用逗号分隔。
CHATSPACE_WEB_ORIGINS=
