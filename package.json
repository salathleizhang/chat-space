{
  "name": "chatspace",
  "type": "module",
  "private": true,
  "workspaces": [
    "app",
    "chat"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3",
    "undici-types": "~8.3.0"
  },
  "overrides": {
    "three": "0.186.1",
    "@types/three": "0.186.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter app dev",
    "dev:local": "bun run --filter chat dev",
    "build": "bun run --filter app build",
    "build:vercel": "bun run typecheck && bun run chat/scripts/browser-build.ts && bun run build && bun run chat/scripts/vercel-api-build.ts",
    "start": "bun run --filter chat start",
    "start:local": "bun run --filter chat start",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run typecheck && bun run test && bun run build",
    "probe:gpu": "bun run --filter app probe:gpu"
  },
  "patchedDependencies": {
    "three@0.186.1": "patches/three@0.186.1.patch",
    "gaussian-splat-lite@1.1.5": "patches/gaussian-splat-lite@1.1.5.patch"
  }
}
