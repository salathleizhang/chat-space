{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "runtime",
    "outDir": "compiled",
    "types": []
  },
  "include": ["runtime/**/*.ts"]
}
