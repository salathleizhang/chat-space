# Server-only Vercel variables. Never use a VITE_ prefix for secrets.
# No database, Blob store or generation queue is required.
CHATSPACE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Provider usage is billed by the provider. Set account spending limits there.
#VOLC_KEY=
#TRIPO_KEY=
#WORLDLABS_KEY=

# Vercel has no Blender installation.
BLENDER_ENABLED=0
# Enable only after dedicated persistent service, TOS and pause/resume pass real acceptance.
# BLENDER_SERVICE_URL=https://blender-api.example.com/
# BLENDER_SERVICE_SECRET=the-same-server-only-service-secret
# vercel.json builds with VITE_BROWSER_LOCAL=1 and an empty VITE_CHAT_URL.
