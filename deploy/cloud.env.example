# Runtime environment for the cloud backend, never Vercel VITE_* variables.
CHAT_HOST=0.0.0.0
CHAT_PORT=3901
CHATSPACE_LIBRARY_DIR=/data/chatspace
# Exact frontend/backend origins, comma-separated. No trailing slash.
CHATSPACE_WEB_ORIGINS=https://your-project.vercel.app,https://api.example.com

# Set the providers you intend to enable on the server.
#VOLC_KEY=
#TRIPO_KEY=
#WORLDLABS_KEY=
#HUNYUAN_KEY=
